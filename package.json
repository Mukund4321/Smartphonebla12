{
  "name": "smart-agri-assistant",
  "version": "1.2.0",
  "private": true,
  "description": "Smart Agri Assistant PWA with unit, Playwright E2E and Postman API tests",
  "scripts": {
    "test": "node --test tests/unit/logic.test.js",
    "test:e2e": "playwright test",
    "test:api": "newman run tests/api/open-meteo.postman_collection.json",
    "test:all": "npm test && playwright test && npm run test:api",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=app.js tests/unit/logic.test.js",
    "report": "playwright show-report",
    "serve": "python -m http.server 8080"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "newman": "6.2.1"
  }
}
